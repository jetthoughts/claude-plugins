#!/bin/sh
# Paperclip API call with the board token. Usage: pc GET /companies/<id>/issues | pc POST /companies/<id>/issues body.json
# Fails loudly on a non-2xx: prints the body (as always) then exits 1 with the status on stderr.
[ -z "${PAPERCLIP_TOKEN:-}" ] && [ -r "$HOME/.secrets" ] && { set -a; . "$HOME/.secrets"; set +a; }
B=http://localhost:3100/api
m=$1; p=$2; body=$3
tmp=$(mktemp)
if [ -n "$body" ]; then
  code=$(curl -s -o "$tmp" -w '%{http_code}' -X "$m" -H "Authorization: Bearer $PAPERCLIP_TOKEN" -H 'Content-Type: application/json' --data-binary "@$body" "$B$p")
else
  code=$(curl -s -o "$tmp" -w '%{http_code}' -X "$m" -H "Authorization: Bearer $PAPERCLIP_TOKEN" "$B$p")
fi
cat "$tmp"
rm -f "$tmp"
case "$code" in
  2??) exit 0 ;;
  *) echo "pc: HTTP $code" >&2; exit 1 ;;
esac
